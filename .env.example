# OpenAI API key used for the AI fact-check step (web search + claim analysis).
# Without this set, the app still runs and scores using source-reputation and
# language/style heuristics only.
OPENAI_API_KEY=

# Model used for fact-checking. Must support the Responses API and, ideally,
# the built-in web_search tool.
OPENAI_MODEL=gpt-4o

# Set to "false" to disable the web_search tool (faster/cheaper, but the
# model will rely only on its training data instead of live sources).
ENABLE_WEB_SEARCH=true

# Composite score weights (should sum to 1.0). These only apply when the AI
# fact-check succeeds; otherwise its weight is redistributed automatically.
WEIGHT_SOURCE_REPUTATION=0.3
WEIGHT_AI_FACT_CHECK=0.5
WEIGHT_LANGUAGE_STYLE=0.2
